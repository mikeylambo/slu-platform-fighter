{
  "name": "slu-platform-fighter",
  "version": "0.0.1",
  "private": true,
  "description": "Deterministic platform-fighter simulation and tooling for the SLU flagship.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lab:movement": "vite apps/movement-lab --host 0.0.0.0",
    "lab:movement:build": "vite build apps/movement-lab --outDir ../../dist-movement-lab --emptyOutDir",
    "lab:combat": "vite apps/combat-lab --host 0.0.0.0",
    "lab:combat:build": "vite build apps/combat-lab --outDir ../../dist-combat-lab --emptyOutDir",
    "fighter:new": "node scripts/fighter-packs.mjs new",
    "fighter:seed": "node scripts/seed-fighter.mjs",
    "roster:seed": "node scripts/seed-roster.mjs",
    "fighter:build": "node scripts/fighter-packs.mjs build",
    "fighter:check": "node scripts/fighter-packs.mjs check",
    "fighter:landing:check": "node scripts/landing-packs.mjs",
    "fighter:audit": "node scripts/fighter-assets.mjs audit",
    "fighter:autobind": "node scripts/fighter-assets.mjs autobind",
    "fighter:frame-data": "node scripts/frame-data.mjs",
    "roster:frame-data": "node scripts/frame-data.mjs --all",
    "roster:report": "node scripts/roster-readiness.mjs",
    "entity:build": "node scripts/entity-packs.mjs build",
    "entity:check": "node scripts/entity-packs.mjs check",
    "stage:build": "node scripts/stage-packs.mjs build",
    "stage:check": "node scripts/stage-packs.mjs check",
    "content:doctor": "node scripts/content-doctor.mjs",
    "content:build": "npm run fighter:build && npm run entity:build && npm run stage:build",
    "content:check": "npm run fighter:check && npm run fighter:landing:check && npm run entity:check && npm run stage:check",
    "fighter:audit:greybox": "blender --background --python scripts/blender/audit_fighter.py -- fighters/greybox/render.json",
    "certify:k0": "node dist/packages/certification/src/k0.js",
    "certify:k1": "node dist/packages/certification/src/k1.js",
    "certify:k1b": "node dist/packages/certification/src/k1b.js",
    "certify:k2": "node dist/packages/certification/src/k2.js",
    "certify:k2match": "node dist/packages/certification/src/k2match.js",
    "certify:k3lifecycle": "node dist/packages/certification/src/k3lifecycle.js",
    "certify:k3knockback": "node dist/packages/certification/src/k3knockback.js",
    "certify:k4stage": "node dist/packages/certification/src/k4stage.js",
    "certify:k5actions": "node dist/packages/certification/src/k5actions.js",
    "certify:k6entities": "node dist/packages/certification/src/k6entities.js",
    "certify:k7move-runtime": "node dist/packages/certification/src/k7moveRuntime.js",
    "certify:k8rollback": "node dist/packages/certification/src/k8rollback.js",
    "certify:k9replay": "node dist/packages/certification/src/k9replay.js",
    "certify:k10soak": "node dist/packages/certification/src/k10soak.js",
    "certify:k11camera": "node dist/packages/certification/src/k11camera.js",
    "certify:k12mixed-roster": "node dist/packages/certification/src/k12mixedRoster.js",
    "certify:k13shell": "node dist/packages/certification/src/k13shell.js",
    "certify:k14match-factory": "node dist/packages/certification/src/k14matchFactory.js",
    "certify:k15teams": "node dist/packages/certification/src/k15teams.js",
    "certify:k16training": "node dist/packages/certification/src/k16training.js",
    "certify:k17attribution": "node dist/packages/certification/src/k17attribution.js",
    "certify:k18match-rules": "node dist/packages/certification/src/k18matchRules.js",
    "certify:k19execution": "node dist/packages/certification/src/k19execution.js",
    "certify:k20team-results": "node dist/packages/certification/src/k20teamResults.js",
    "certify:k21netcode": "node dist/packages/certification/src/k21netcode.js",
    "certify:k22animation": "node dist/packages/certification/src/k22animation.js",
    "certify:k23content-fighter": "node dist/packages/certification/src/k23contentFighter.js",
    "certify:k24aerial-landing": "node dist/packages/certification/src/k24aerialLanding.js",
    "certify:k25training-telemetry": "node dist/packages/certification/src/k25trainingTelemetry.js",
    "certify:k26presentation-events": "node dist/packages/certification/src/k26presentationEvents.js",
    "soak:matches": "node dist/packages/certification/src/k10soak.js",
    "verify": "npm run content:check && npm run content:build && npm run build && npm run certify:k0 && npm run certify:k1 && npm run certify:k1b && npm run certify:k2 && npm run certify:k2match && npm run certify:k3lifecycle && npm run certify:k3knockback && npm run certify:k4stage && npm run certify:k5actions && npm run certify:k6entities && npm run certify:k7move-runtime && npm run certify:k8rollback && npm run certify:k9replay && npm run certify:k10soak && npm run certify:k11camera && npm run certify:k12mixed-roster && npm run certify:k13shell && npm run certify:k14match-factory && npm run certify:k15teams && npm run certify:k16training && npm run certify:k17attribution && npm run certify:k18match-rules && npm run certify:k19execution && npm run certify:k20team-results && npm run certify:k21netcode && npm run certify:k22animation && npm run certify:k23content-fighter && npm run certify:k24aerial-landing && npm run certify:k25training-telemetry && npm run certify:k26presentation-events && npm run lab:movement:build && npm run lab:combat:build"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/three": "^0.185.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
