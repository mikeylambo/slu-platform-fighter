{
  "name": "slu-platform-fighter",
  "version": "0.0.1",
  "private": true,
  "description": "Deterministic platform-fighter simulation and tooling for the SLU flagship.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "fighter:new": "node scripts/fighter-packs.mjs new",
    "fighter:build": "node scripts/fighter-packs.mjs build",
    "fighter:check": "node scripts/fighter-packs.mjs check",
    "content:doctor": "node scripts/content-doctor.mjs",
    "content:build": "npm run fighter:build",
    "content:check": "npm run fighter:check",
    "fighter:audit:greybox": "blender --background --python scripts/blender/audit_fighter.py -- fighters/greybox/render.json",
    "verify": "npm run content:check && npm run content:build && npm run build && node dist/packages/certification/src/k0.js"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
